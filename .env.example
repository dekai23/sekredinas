# ============================================================
#  SekreDinas - BKPSDM Kabupaten Yahukimo
#  Salin menjadi .env.local lalu isi nilainya.
# ============================================================

# --- Basis data -------------------------------------------------
# KOSONGKAN untuk memakai PGlite (PostgreSQL tertanam, folder .database/).
# Cocok untuk pengembangan & server kantor tanpa instalasi PostgreSQL.
# Isi URL PostgreSQL bila sudah tersedia (mis. data center Diskominfo):
#   DATABASE_URL=postgresql://user:password@host:5432/sekredinas
DATABASE_URL=

# Lokasi berkas PGlite saat DATABASE_URL kosong
PGDATA_DIR=.database/sekredinas

# --- Keamanan ---------------------------------------------------
# Wajib diganti di produksi. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=ubah-saya-dengan-string-acak-64-karakter

# Umur sesi (detik). 8 jam kerja = 28800
SESSION_MAX_AGE=28800

# --- Aplikasi ---------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
ZONA_WAKTU=Asia/Jayapura

# --- Seed / akun awal -------------------------------------------
# Password awal untuk seluruh akun saat seeding pertama kali.
# WAJIB diganti setiap pengguna setelah login pertama.
SEED_DEFAULT_PASSWORD=Bkpsdm-Yahukimo2026

# --- Unggahan berkas --------------------------------------------
UPLOAD_DIR=.uploads
UKURAN_MAKS_SURAT_MB=10
UKURAN_MAKS_ARSIP_MB=25

# Nomor telepon kantor (dipakai di halaman kontak & kop digital)
NEXT_PUBLIC_TELEPON_KANTOR=

# --- Notifikasi WhatsApp (opsional, Fase 5) ---------------------
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
